[Unit]
Description=Elite AKV Automated US Post Scheduler Daemon
After=network.target

[Service]
Type=simple
User=AK
WorkingDirectory=/home/AK/social_system
ExecStart=/usr/bin/python3 /home/AK/social_system/post_scheduler.py --daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
